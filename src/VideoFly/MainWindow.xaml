<Window x:Class="VideoFly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoFly" Width="1280" Height="800" MinWidth="640" MinHeight="420"
        Background="#111111" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre du haut avec le bouton menu -->
        <DockPanel Grid.Row="0" Background="#1E1E1E" Height="40" LastChildFill="False">
            <Button x:Name="MenuButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                    Content="&#xE700;" ToolTip="Menu" Margin="6,0" Click="MenuButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Fichier">
                            <MenuItem Header="_Ouvrir une vidéo…" InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                            <MenuItem x:Name="HistoryMenu" Header="_Historique" SubmenuOpened="HistoryMenu_SubmenuOpened">
                                <MenuItem Header="…" />
                            </MenuItem>
                            <MenuItem Header="_Fermer toutes les vignettes" Click="CloseAll_Click" />
                            <Separator />
                            <MenuItem Header="_Quitter" Click="Quit_Click" />
                        </MenuItem>
                        <MenuItem x:Name="LayoutMenu" Header="_Vignettes" SubmenuOpened="LayoutMenu_SubmenuOpened">
                            <MenuItem Header="…" />
                        </MenuItem>
                        <MenuItem Header="_Options…" Click="Options_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button x:Name="LayoutButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                    Content="&#xE80A;" ToolTip="Organiser les vignettes" Margin="0,0,6,0" Click="LayoutButton_Click" ContextMenuOpening="LayoutButton_ContextMenuOpening">
                <Button.ContextMenu>
                    <ContextMenu />
                </Button.ContextMenu>
            </Button>
            <TextBlock DockPanel.Dock="Left" Text="VideoFly" Foreground="#AAAAAA" VerticalAlignment="Center"
                       FontWeight="SemiBold" Margin="4,0" />
        </DockPanel>

        <!-- Zone des vignettes -->
        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#666666" FontSize="15" TextAlignment="Center" IsHitTestVisible="False"
                       Text="Menu › Fichier › Ouvrir une vidéo (Ctrl+O)&#x0a;ou glissez des fichiers vidéo ici" />
            <Canvas x:Name="Desktop" Background="Transparent" ClipToBounds="True"
                    SizeChanged="Desktop_SizeChanged" />
        </Grid>
    </Grid>
</Window>
