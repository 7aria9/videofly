<Window x:Class="VideoFly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoFly" Icon="/VideoFly.ico" Width="1280" Height="800" MinWidth="640" MinHeight="420"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown" Closing="Window_Closing">

    <!-- Fenêtre sans cadre Windows : la barre de titre fait partie de l'interface. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barre de titre : menu, organisation des vignettes, nom, boutons de fenêtre -->
            <DockPanel Grid.Row="0" Background="{StaticResource WindowBrush}" LastChildFill="False">
                <Button x:Name="MenuButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        Content="&#xE700;" ToolTip="Menu" Margin="8,0,2,0" Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Fichier">
                                <MenuItem Header="_Ouvrir…" InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                                <MenuItem Header="Ouvrir une _playlist…" Click="OpenPlaylist_Click" />
                                <MenuItem Header="_Nouvelle playlist" Click="NewPlaylist_Click" />
                                <Separator />
                                <MenuItem Header="Ouvrir une _session…" Click="OpenSessionFile_Click" />
                                <MenuItem Header="_Enregistrer la session…" InputGestureText="Ctrl+S" Click="SaveSessionFile_Click" />
                                <Separator />
                                <MenuItem x:Name="HistoryMenu" Header="_Historique" SubmenuOpened="HistoryMenu_SubmenuOpened">
                                    <MenuItem Header="…" />
                                </MenuItem>
                                <MenuItem Header="_Fermer toutes les vignettes" Click="CloseAll_Click" />
                                <Separator />
                                <MenuItem Header="_Quitter" Click="Quit_Click" />
                            </MenuItem>
                            <MenuItem x:Name="LayoutMenu" Header="_Vignettes" SubmenuOpened="LayoutMenu_SubmenuOpened">
                                <MenuItem Header="…" />
                            </MenuItem>
                            <MenuItem Header="_Options…" Click="Options_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="LayoutButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        Content="&#xE80A;" ToolTip="Organiser les vignettes" Click="LayoutButton_Click"
                        ContextMenuOpening="LayoutButton_ContextMenuOpening">
                    <Button.ContextMenu>
                        <ContextMenu />
                    </Button.ContextMenu>
                </Button>
                <Image DockPanel.Dock="Left" Source="/Assets/logo-32.png" Width="16" Height="16" Margin="12,0,0,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock DockPanel.Dock="Left" Text="VideoFly" Foreground="{StaticResource SubtleTextBrush}"
                           VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />

                <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                        ToolTip="Fermer" Click="CloseWindow_Click" />
                <Button x:Name="MaximizeWindowButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" ToolTip="Agrandir" Click="MaximizeWindow_Click" />
                <Button x:Name="GlobalPlayPauseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        Content="&#xE768;" ToolTip="Tout lire / tout mettre en pause (Ctrl+Espace)"
                        Click="GlobalPlayPause_Click" Margin="0,0,8,0" IsEnabled="False" />
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        ToolTip="Réduire" Click="MinimizeWindow_Click" />
            </DockPanel>

            <!-- Zone des vignettes -->
            <Grid Grid.Row="1" Margin="8,0,8,8">
                <!-- Écran d'accueil quand aucune vidéo n'est ouverte -->
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="48"
                               Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Aucun média ouvert" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock Text="Glissez des vidéos, musiques ou playlists ici, ou ouvrez-les (Ctrl+O)" FontSize="13"
                               Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource AccentButton}" Content="Ouvrir un fichier" HorizontalAlignment="Center"
                            Margin="0,20,0,0" Click="OpenFile_Click" />
                </StackPanel>
                <Canvas x:Name="Desktop" Background="Transparent" ClipToBounds="True"
                        SizeChanged="Desktop_SizeChanged" />
            </Grid>
        </Grid>
    </Border>
</Window>
