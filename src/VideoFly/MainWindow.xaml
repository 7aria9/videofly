<Window x:Class="VideoFly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="VideoFly" Width="960" Height="600" MinWidth="520" MinHeight="240"
        Background="#111111" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Zone vidéo : LibVLC adapte l'image à la taille de la zone en gardant les proportions. -->
        <vlc:VideoView x:Name="VideoView" Grid.Row="0" Background="Black" />

        <!-- Barre de progression -->
        <Grid Grid.Row="1" Background="#1E1E1E" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="SeekSlider" Grid.Column="0" Minimum="0" Maximum="1000" Margin="10,6,8,0"
                    IsMoveToPointEnabled="True" IsEnabled="False" Focusable="False"
                    ValueChanged="SeekSlider_ValueChanged"
                    PreviewMouseLeftButtonDown="SeekSlider_DragStart"
                    PreviewMouseLeftButtonUp="SeekSlider_DragEnd" />
            <TextBlock x:Name="TimeText" Grid.Column="1" Text="00:00 / 00:00" Foreground="#CCCCCC"
                       VerticalAlignment="Center" Margin="0,6,10,0" FontFamily="Consolas" />
        </Grid>

        <!-- Barre de commandes -->
        <DockPanel Grid.Row="2" Background="#1E1E1E" LastChildFill="False" Height="44">
            <Button x:Name="MenuButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                    Content="&#xE700;" ToolTip="Menu" Margin="8,0,6,0" Click="MenuButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Fichier">
                            <MenuItem Header="_Ouvrir une vidéo…" InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                            <Separator />
                            <MenuItem Header="_Quitter" Click="Quit_Click" />
                        </MenuItem>
                        <MenuItem Header="_Options…" Click="Options_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Button x:Name="PreviousButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                    Content="&#xE892;" ToolTip="Précédent" Click="PreviousButton_Click" />
            <Button x:Name="RewindButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                    Content="&#xEB9E;" ToolTip="Retour rapide (x2, x4, x8, x16)" Click="RewindButton_Click" />
            <Button x:Name="PlayPauseButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                    Content="&#xE768;" ToolTip="Lecture / Pause" FontSize="20" Width="44" Click="PlayPauseButton_Click" />
            <Button x:Name="ForwardButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                    Content="&#xEB9D;" ToolTip="Avance rapide (x2, x4, x8, x16)" Click="ForwardButton_Click" />
            <Button x:Name="NextButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                    Content="&#xE893;" ToolTip="Suivant" Click="NextButton_Click" />

            <TextBlock x:Name="SpeedText" DockPanel.Dock="Left" Foreground="#FFB300" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="40" />

            <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="110" Minimum="0" Maximum="100"
                    VerticalAlignment="Center" Margin="0,0,12,0" IsMoveToPointEnabled="True" Focusable="False"
                    ToolTip="Volume" ValueChanged="VolumeSlider_ValueChanged" />
            <Button x:Name="MuteButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    Content="&#xE767;" ToolTip="Couper le son" Click="MuteButton_Click" />
        </DockPanel>
    </Grid>
</Window>
