<Window x:Class="VideoFly.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Icon="/VideoFly.ico" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24,20,24,20" Width="420">
        <TextBlock Text="Options" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />

        <TextBlock Text="AFFICHAGE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}"
                   Margin="0,0,0,8" />
        <Border Background="{StaticResource ElevatedBrush}" CornerRadius="8" Padding="16,14">
            <StackPanel>
                <CheckBox x:Name="AutoResizeCheck" Style="{StaticResource ToggleSwitch}">
                    <StackPanel>
                        <TextBlock Text="Adapter la vignette à la vidéo" />
                        <TextBlock Text="À l'ouverture, la vignette prend la taille de la vidéo"
                                   FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <TextBlock Text="PROGRAMME PAR DÉFAUT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}"
                   Margin="0,20,0,8" />
        <Border Background="{StaticResource ElevatedBrush}" CornerRadius="8" Padding="16,14">
            <StackPanel>
                <TextBlock Text="Ouvrir les vidéos, musiques et playlists avec VideoFly" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,12"
                           Text="Déclare VideoFly auprès de Windows, puis ouvre les réglages où il suffit de le choisir comme lecteur vidéo. Ensuite, un double-clic sur un fichier l'ouvre dans VideoFly (dans une nouvelle vignette si VideoFly est déjà ouvert)." />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RegisterButton" Content="Définir par défaut…" Style="{StaticResource AccentButton}"
                            Click="Register_Click" Margin="0,0,8,0" />
                    <Button x:Name="UnregisterButton" Content="Retirer" Style="{StaticResource TextButton}" Click="Unregister_Click" />
                </StackPanel>
                <TextBlock x:Name="AssociationStatus" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                           Foreground="{StaticResource SubtleTextBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annuler" Style="{StaticResource TextButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Enregistrer" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
