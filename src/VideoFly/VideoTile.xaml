<UserControl x:Class="VideoFly.VideoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="240" MinHeight="160" FontFamily="{StaticResource UiFont}"
             PreviewMouseDown="Tile_PreviewMouseDown" MouseMove="Tile_MouseMove" MouseLeave="Tile_MouseLeave"
             SizeChanged="Tile_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Cadre arrondi ; la bordure passe en couleur d'accent quand la vignette est active -->
        <Border x:Name="Frame" Background="Black" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid x:Name="Surface" SizeChanged="Surface_SizeChanged">

                <!-- Image vidéo : remplit toute la vignette en gardant les proportions -->
                <Grid x:Name="VideoHost" Background="Black" MouseLeftButtonDown="VideoHost_MouseLeftButtonDown">
                    <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
                </Grid>

                <!-- Bandeau du haut (en surimpression) : glisser pour déplacer, double-clic pour agrandir -->
                <Grid x:Name="TopOverlay" VerticalAlignment="Top" Height="44">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B0000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Thumb x:Name="TitleThumb" Style="{StaticResource InvisibleThumb}" Cursor="SizeAll"
                           DragDelta="TitleThumb_DragDelta" DragCompleted="TitleThumb_DragCompleted"
                           MouseDoubleClick="TitleThumb_DoubleClick">
                        <Thumb.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Mettre à la place principale" Click="MoveToMain_Click" />
                            </ContextMenu>
                        </Thumb.ContextMenu>
                    </Thumb>
                    <TextBlock x:Name="TitleText" Text="Vidéo" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Top" Margin="14,10,76,0"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0">
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}"
                                Content="&#xE922;" ToolTip="Agrandir" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource TitleButton}"
                                Content="&#xE8BB;" ToolTip="Fermer" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Vitesse d'avance / retour rapide -->
                <Border x:Name="SpeedBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,40,0,0"
                        Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="9,3" Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="SpeedText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                </Border>

                <!-- Commandes (en surimpression, s'effacent pendant la lecture) -->
                <Grid x:Name="BottomOverlay" VerticalAlignment="Bottom">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#C8000000" Offset="0.55" />
                            <GradientStop Color="#E0000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <StackPanel Margin="12,28,12,8">
                        <Slider x:Name="SeekSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="1000"
                                ValueChanged="SeekSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="SeekSlider_DragStart"
                                PreviewMouseLeftButtonUp="SeekSlider_DragEnd" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TimeText" Grid.Column="0" Text="0:00 / 0:00" FontSize="12"
                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource TileButton}" Content="&#xE892;"
                                        ToolTip="Précédent" Click="PreviousButton_Click" />
                                <Button Style="{StaticResource TileButton}" Content="&#xEB9E;"
                                        ToolTip="Retour rapide (x2, x4, x8, x16)" Click="RewindButton_Click" />
                                <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}"
                                        Content="&#xE768;" ToolTip="Lecture / Pause" Click="PlayPauseButton_Click" />
                                <Button Style="{StaticResource TileButton}" Content="&#xEB9D;"
                                        ToolTip="Avance rapide (x2, x4, x8, x16)" Click="ForwardButton_Click" />
                                <Button Style="{StaticResource TileButton}" Content="&#xE893;"
                                        ToolTip="Suivant" Click="NextButton_Click" />
                            </StackPanel>

                            <StackPanel x:Name="VolumePanel" Grid.Column="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="MuteButton" Style="{StaticResource TileButton}"
                                        Content="&#xE767;" ToolTip="Couper le son" Click="MuteButton_Click" />
                                <Slider x:Name="VolumeSlider" Style="{StaticResource ModernSlider}" Width="72"
                                        Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="2,0,0,0"
                                        ToolTip="Volume" ValueChanged="VolumeSlider_ValueChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Poignées de redimensionnement (bords et coins) -->
        <Grid>
            <Thumb Tag="L"  Width="5" HorizontalAlignment="Left"  Cursor="SizeWE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="R"  Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="T"  Height="4" VerticalAlignment="Top"    Cursor="SizeNS" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="B"  Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="TL" Width="10" Height="10" HorizontalAlignment="Left"  VerticalAlignment="Top"    Cursor="SizeNWSE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="TR" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"    Cursor="SizeNESW" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="BL" Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Cursor="SizeNESW" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="BR" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
        </Grid>
    </Grid>
</UserControl>
