<UserControl x:Class="VideoFly.VideoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="240" MinHeight="160"
             PreviewMouseDown="Tile_PreviewMouseDown">
    <UserControl.Resources>
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="Frame" Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barre de titre : glisser pour déplacer, double-clic pour agrandir -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="#2A2A2A">
                <Thumb Style="{StaticResource InvisibleThumb}" Cursor="SizeAll"
                       DragDelta="TitleThumb_DragDelta" MouseDoubleClick="TitleThumb_DoubleClick" />
                <TextBlock x:Name="TitleText" Text="Vidéo" Foreground="#DDDDDD" VerticalAlignment="Center"
                           Margin="10,0,72,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MaximizeButton" Style="{StaticResource TileButton}" Height="26" FontSize="10"
                            Content="&#xE922;" ToolTip="Agrandir" Click="MaximizeButton_Click" />
                    <Button Style="{StaticResource TileButton}" Height="26" FontSize="10"
                            Content="&#xE8BB;" ToolTip="Fermer" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Image vidéo : s'adapte à la taille de la vignette en gardant les proportions -->
            <Grid Grid.Row="1" x:Name="VideoHost" Background="Black" ClipToBounds="True"
                  MouseLeftButtonDown="VideoHost_MouseLeftButtonDown">
                <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
            </Grid>

            <!-- Barre de progression -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="SeekSlider" Minimum="0" Maximum="1000" Margin="8,4,6,0"
                        IsMoveToPointEnabled="True" Focusable="False"
                        ValueChanged="SeekSlider_ValueChanged"
                        PreviewMouseLeftButtonDown="SeekSlider_DragStart"
                        PreviewMouseLeftButtonUp="SeekSlider_DragEnd" />
                <TextBlock x:Name="TimeText" Grid.Column="1" Text="00:00 / 00:00" Foreground="#CCCCCC"
                           VerticalAlignment="Center" Margin="0,4,8,0" FontFamily="Consolas" FontSize="11" />
            </Grid>

            <!-- Commandes -->
            <DockPanel Grid.Row="3" LastChildFill="False" Height="38" Margin="4,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource TileButton}" Content="&#xE892;"
                        ToolTip="Précédent" Click="PreviousButton_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource TileButton}" Content="&#xEB9E;"
                        ToolTip="Retour rapide (x2, x4, x8, x16)" Click="RewindButton_Click" />
                <Button x:Name="PlayPauseButton" DockPanel.Dock="Left" Style="{StaticResource TileButton}"
                        Content="&#xE768;" ToolTip="Lecture / Pause" FontSize="18" Width="40" Click="PlayPauseButton_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource TileButton}" Content="&#xEB9D;"
                        ToolTip="Avance rapide (x2, x4, x8, x16)" Click="ForwardButton_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource TileButton}" Content="&#xE893;"
                        ToolTip="Suivant" Click="NextButton_Click" />
                <TextBlock x:Name="SpeedText" DockPanel.Dock="Left" Foreground="#FFB300" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="8,0,0,0" />

                <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="80" Minimum="0" Maximum="100"
                        VerticalAlignment="Center" Margin="0,0,6,0" IsMoveToPointEnabled="True" Focusable="False"
                        ToolTip="Volume" ValueChanged="VolumeSlider_ValueChanged" />
                <Button x:Name="MuteButton" DockPanel.Dock="Right" Style="{StaticResource TileButton}"
                        Content="&#xE767;" ToolTip="Couper le son" Click="MuteButton_Click" />
            </DockPanel>

            <!-- Poignées de redimensionnement (bords et coins) -->
            <Grid Grid.RowSpan="4">
                <Thumb Tag="L"  Width="5" HorizontalAlignment="Left"  Cursor="SizeWE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="R"  Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="T"  Height="4" VerticalAlignment="Top"    Cursor="SizeNS" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="B"  Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="TL" Width="10" Height="10" HorizontalAlignment="Left"  VerticalAlignment="Top"    Cursor="SizeNWSE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="TR" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"    Cursor="SizeNESW" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="BL" Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Cursor="SizeNESW" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="BR" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
