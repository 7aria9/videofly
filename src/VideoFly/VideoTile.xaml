<UserControl x:Class="VideoFly.VideoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VideoFly"
             MinWidth="240" MinHeight="160" FontFamily="{StaticResource UiFont}"
             PreviewMouseDown="Tile_PreviewMouseDown" MouseMove="Tile_MouseMove" MouseLeave="Tile_MouseLeave"
             SizeChanged="Tile_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Lignes de la playlist -->
        <Style x:Key="PlaylistItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,5" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PlaylistItemTemplate" DataType="{x:Type local:PlaylistItem}">
            <Grid ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PlayingIcon" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="KindIcon" Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="Name" Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource PanelButton}" Width="22" Height="22"
                        FontSize="9" Content="&#xE8BB;" ToolTip="Retirer de la playlist" Visibility="Hidden"
                        Tag="{Binding}" Click="RemoveItem_Click" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Num" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="PlayingIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAudio}" Value="True">
                    <Setter TargetName="KindIcon" Property="Text" Value="&#xE8D6;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Cadre arrondi ; la bordure passe en couleur d'accent quand la vignette est active -->
        <Border x:Name="Frame" Background="Black" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid x:Name="Surface" SizeChanged="Surface_SizeChanged">

                <!-- Image vidéo : remplit toute la vignette en gardant les proportions -->
                <Grid x:Name="VideoHost" Background="Black" MouseLeftButtonDown="VideoHost_MouseLeftButtonDown">
                    <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />

                    <!-- Fichier audio (ou playlist vide) : pochette, titre et artiste à la place de l'image -->
                    <Grid x:Name="AudioView" Visibility="Collapsed">
                        <Grid.Background>
                            <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.35" RadiusX="0.8" RadiusY="0.8">
                                <GradientStop Color="#1E2A44" Offset="0" />
                                <GradientStop Color="#0E0E11" Offset="1" />
                            </RadialGradientBrush>
                        </Grid.Background>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24,48,24,100">
                            <StackPanel Width="320">
                                <Border Width="180" Height="180" CornerRadius="14" Background="{StaticResource ElevatedBrush}"
                                        HorizontalAlignment="Center" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock x:Name="AudioIcon" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="64" Foreground="{StaticResource FaintTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="CoverImage" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="AudioTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,18,0,4" />
                                <TextBlock x:Name="AudioArtist" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                </Grid>

                <!-- Bandeau du haut (en surimpression) : glisser pour déplacer, double-clic pour agrandir -->
                <Grid x:Name="TopOverlay" VerticalAlignment="Top" Height="44">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B0000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Thumb x:Name="TitleThumb" Style="{StaticResource InvisibleThumb}" Cursor="SizeAll"
                           DragDelta="TitleThumb_DragDelta" DragCompleted="TitleThumb_DragCompleted"
                           MouseDoubleClick="TitleThumb_DoubleClick">
                        <Thumb.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Mettre à la place principale" Click="MoveToMain_Click" />
                            </ContextMenu>
                        </Thumb.ContextMenu>
                    </Thumb>
                    <TextBlock x:Name="TitleText" Text="Vidéo" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Top" Margin="14,10,106,0"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0">
                        <Button x:Name="FullScreenButton" Style="{StaticResource TitleButton}"
                                Content="&#xE740;" ToolTip="Plein écran (F11)" Click="FullScreenButton_Click" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}"
                                Content="&#xE922;" ToolTip="Agrandir" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource TitleButton}"
                                Content="&#xE8BB;" ToolTip="Fermer" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Vitesse d'avance / retour rapide -->
                <Border x:Name="SpeedBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,40,0,0"
                        Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="9,3" Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="SpeedText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                </Border>

                <!-- Commandes (en surimpression, s'effacent pendant la lecture) -->
                <Grid x:Name="BottomOverlay" VerticalAlignment="Bottom">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#C8000000" Offset="0.55" />
                            <GradientStop Color="#E0000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <StackPanel Margin="12,28,12,8">
                        <Slider x:Name="SeekSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="1000"
                                ValueChanged="SeekSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="SeekSlider_DragStart"
                                PreviewMouseLeftButtonUp="SeekSlider_DragEnd"
                                MouseMove="SeekSlider_MouseMove" MouseLeave="SeekSlider_MouseLeave" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TimeText" Grid.Column="0" Text="0:00 / 0:00" FontSize="12"
                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="RepeatButton" Style="{StaticResource TileButton}" Content="&#xE8EE;"
                                        Foreground="{StaticResource AccentBrush}" Margin="1,0,8,0"
                                        ToolTip="Relecture automatique : activée" Click="RepeatButton_Click" />
                                <Button Style="{StaticResource TileButton}" Content="&#xE892;"
                                        ToolTip="Précédent" Click="PreviousButton_Click" />
                                <Button Style="{StaticResource TileButton}" Content="&#xEB9E;"
                                        ToolTip="Retour rapide (x2, x4, x8, x16)" Click="RewindButton_Click" />
                                <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}"
                                        Content="&#xE768;" ToolTip="Lecture / Pause" Click="PlayPauseButton_Click" />
                                <Button Style="{StaticResource TileButton}" Content="&#xEB9D;"
                                        ToolTip="Avance rapide (x2, x4, x8, x16)" Click="ForwardButton_Click" />
                                <Button Style="{StaticResource TileButton}" Content="&#xE893;"
                                        ToolTip="Suivant" Click="NextButton_Click" />
                            </StackPanel>

                            <StackPanel x:Name="VolumePanel" Grid.Column="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="PlaylistButton" Style="{StaticResource TileButton}"
                                        Content="&#xE8FD;" ToolTip="Playlist" Click="PlaylistButton_Click" />
                                <Button x:Name="MuteButton" Style="{StaticResource TileButton}"
                                        Content="&#xE767;" ToolTip="Couper le son" Click="MuteButton_Click" />
                                <Slider x:Name="VolumeSlider" Style="{StaticResource ModernSlider}" Width="96"
                                        Minimum="0" Maximum="250" VerticalAlignment="Center" Margin="2,0,0,0"
                                        ToolTip="Volume (jusqu'à 250 %, molette pour régler)"
                                        ValueChanged="VolumeSlider_ValueChanged" MouseWheel="VolumeSlider_MouseWheel" />
                                <TextBlock x:Name="VolumeText" Width="38" FontSize="11" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="2,0,2,0"
                                           Foreground="{StaticResource SubtleTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Panneau playlist (à droite, au-dessus de la vidéo) -->
                <Border x:Name="PlaylistPanel" HorizontalAlignment="Right" Width="290" Margin="0,44,8,96"
                        Background="#EE16161A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Visibility="Collapsed">
                    <Grid Margin="10,8,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="2,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelButton}" Content="&#xE8BB;" FontSize="10"
                                    ToolTip="Fermer la playlist" Click="PlaylistButton_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelButton}" Content="&#xE74E;"
                                    ToolTip="Enregistrer la playlist…" Click="SavePlaylist_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelButton}" Content="&#xE8E5;"
                                    ToolTip="Charger une playlist…" Click="LoadPlaylist_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource PanelButton}" Content="&#xE710;"
                                    ToolTip="Ajouter des fichiers…" Click="AddFiles_Click" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Playlist" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="PlaylistCount" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <TextBlock x:Name="PlaylistEmpty" Text="Glissez des fichiers ici&#x0a;ou cliquez sur +" FontSize="12"
                                       Foreground="{StaticResource SubtleTextBrush}" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <ListBox x:Name="PlaylistList" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                     ItemContainerStyle="{StaticResource PlaylistItemStyle}"
                                     ItemTemplate="{StaticResource PlaylistItemTemplate}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AllowDrop="True" Drop="PlaylistList_Drop" DragOver="PlaylistList_DragOver"
                                     PreviewMouseLeftButtonDown="PlaylistList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="PlaylistList_PreviewMouseMove"
                                     MouseDoubleClick="PlaylistList_MouseDoubleClick" PreviewKeyDown="PlaylistList_KeyDown" />
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource PanelButton}" Content="&#xE74A;" ToolTip="Monter" Click="MoveUp_Click" />
                            <Button Style="{StaticResource PanelButton}" Content="&#xE74B;" ToolTip="Descendre" Click="MoveDown_Click" />
                            <Button Style="{StaticResource PanelButton}" Content="&#xE74D;" ToolTip="Retirer la sélection (Suppr)"
                                    Click="RemoveSelected_Click" />
                            <Button Style="{StaticResource PanelButton}" Content="&#xE894;" ToolTip="Vider la playlist"
                                    Click="ClearPlaylist_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Aperçu au survol de la barre de progression : dessiné dans la vignette (pas de fenêtre
                     séparée), il ne peut donc jamais sortir de VideoFly ni passer sur un autre écran. -->
                <Canvas x:Name="SeekPreviewLayer" IsHitTestVisible="False" ClipToBounds="False">
                    <Border x:Name="SeekPreviewBox" Visibility="Collapsed" Background="#F016161A"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                        <StackPanel>
                            <Border x:Name="SeekPreviewFrame" Width="192" Height="108" CornerRadius="5" Background="Black">
                                <Image x:Name="SeekPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
                            </Border>
                            <TextBlock x:Name="SeekPreviewTime" HorizontalAlignment="Center" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="6,3,6,1" />
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!-- Poignées de redimensionnement (bords et coins) -->
        <Grid>
            <Thumb Tag="L"  Width="5" HorizontalAlignment="Left"  Cursor="SizeWE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="R"  Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="T"  Height="4" VerticalAlignment="Top"    Cursor="SizeNS" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="B"  Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="TL" Width="10" Height="10" HorizontalAlignment="Left"  VerticalAlignment="Top"    Cursor="SizeNWSE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="TR" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"    Cursor="SizeNESW" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="BL" Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Cursor="SizeNESW" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
            <Thumb Tag="BR" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Style="{StaticResource InvisibleThumb}" DragDelta="ResizeThumb_DragDelta" />
        </Grid>
    </Grid>
</UserControl>
